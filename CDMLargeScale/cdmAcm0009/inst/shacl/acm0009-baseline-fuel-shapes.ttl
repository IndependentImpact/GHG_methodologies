@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

cdm:Acm0009BaselineFuelShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "ACM0009 baseline fuel"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasBaselineFuelType> ;
        sh:class <http://independentimpact.org/cdm/FossilFuel> ;
        sh:minCount 1 ;
        sh:message "ACM0009 condition (a): baseline must use fossil fuels (coal and/or petroleum products) that are switched to natural gas."@en
    ] .
