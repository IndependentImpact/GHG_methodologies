@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# ACM0012 — technology type applicability shape.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:Acm0012TechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "ACM0012 technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/WasteEnergyRecovery> ;
        sh:minCount 1 ;
        sh:message "ACM0012 condition (a): project must implement a waste energy recovery system capturing waste heat, gas, or pressure streams."@en
    ] .
