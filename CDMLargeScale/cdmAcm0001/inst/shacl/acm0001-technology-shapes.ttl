@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# ACM0001 — technology type applicability shape.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:Acm0001TechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "ACM0001 technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/LandfillGasCapture> ;
        sh:minCount 1 ;
        sh:message "ACM0001 condition (a): project must implement a landfill gas capture system."@en
    ] .
