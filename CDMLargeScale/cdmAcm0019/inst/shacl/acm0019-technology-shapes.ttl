@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# ACM0019 — technology type applicability shape.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:Acm0019TechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "ACM0019 technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/N2OAbatementTechnology> ;
        sh:minCount 1 ;
        sh:message "ACM0019 condition (a): project must implement an N2O abatement technology at a nitric acid or adipic acid production plant."@en
    ] .
