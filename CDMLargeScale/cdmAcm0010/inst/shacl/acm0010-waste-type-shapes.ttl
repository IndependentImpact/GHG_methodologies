@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

cdm:Acm0010WasteTypeShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "ACM0010 waste type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasWasteType> ;
        sh:class <http://independentimpact.org/cdm/AnimalManure> ;
        sh:minCount 1 ;
        sh:message "ACM0010 condition (b): waste stream must be animal manure or high-strength organic wastewater."@en
    ] .
