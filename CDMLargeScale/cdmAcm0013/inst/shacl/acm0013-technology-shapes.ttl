@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# ACM0013 — technology type applicability shape.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:Acm0013TechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "ACM0013 technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/NonRenewableEnergyTechnology> ;
        sh:minCount 1 ;
        sh:message "ACM0013 condition (a): project must be a new fossil fuel power plant using a less GHG-intensive technology than the displaced baseline."@en
    ] .
