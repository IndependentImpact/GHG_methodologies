@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# ACM0018 — technology type applicability shape.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:Acm0018TechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "ACM0018 technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/RenewableBiomassSystem> ;
        sh:minCount 1 ;
        sh:message "ACM0018 condition (a): project must use a renewable biomass system as the primary fuel in a power-only plant."@en
    ] .
