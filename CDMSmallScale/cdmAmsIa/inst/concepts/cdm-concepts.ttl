@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Concept schemes
#################################################################

cdm:TechnologyTypeScheme a skos:ConceptScheme ;
    dct:title "CDM Technology Type Scheme"@en ;
    skos:definition "Classifies energy technologies by their primary fuel source. Used to determine eligibility of the project activity under CDM applicability conditions."@en ;
    skos:hasTopConcept cdm:RenewableEnergyTechnology, cdm:NonRenewableEnergyTechnology .

cdm:EnergySourceScheme a skos:ConceptScheme ;
    dct:title "CDM Energy Source Scheme"@en ;
    skos:definition "Classifies fuels and primary energy sources. Used to characterise the baseline energy source being displaced by the project activity."@en ;
    skos:hasTopConcept cdm:FossilFuel, cdm:BiomassSource .

cdm:GridConnectionScheme a skos:ConceptScheme ;
    dct:title "CDM Grid Connection Scheme"@en ;
    skos:definition "Classifies project activities by their relationship to the electricity grid."@en ;
    skos:hasTopConcept cdm:GridConnectedSystem, cdm:OffGridSystem, cdm:MiniGridSystem, cdm:CaptiveUseSystem .

cdm:SectoralScopeScheme a skos:ConceptScheme ;
    dct:title "CDM Sectoral Scope Scheme"@en ;
    skos:definition "UNFCCC CDM sectoral scopes 1–15."@en ;
    skos:hasTopConcept
        cdm:SectoralScope1, cdm:SectoralScope2, cdm:SectoralScope3,
        cdm:SectoralScope4, cdm:SectoralScope5, cdm:SectoralScope6,
        cdm:SectoralScope7, cdm:SectoralScope8, cdm:SectoralScope9,
        cdm:SectoralScope10, cdm:SectoralScope11, cdm:SectoralScope12,
        cdm:SectoralScope13, cdm:SectoralScope14, cdm:SectoralScope15 .

cdm:ScaleScheme a skos:ConceptScheme ;
    dct:title "CDM Scale Scheme"@en ;
    skos:definition "Distinguishes CDM large-scale from small-scale (AMS) methodologies."@en ;
    skos:hasTopConcept cdm:LargeScale, cdm:SmallScale .

#################################################################
# TechnologyTypeScheme concepts
#################################################################

cdm:RenewableEnergyTechnology a skos:Concept ;
    skos:inScheme cdm:TechnologyTypeScheme ;
    skos:topConceptOf cdm:TechnologyTypeScheme ;
    skos:prefLabel "Renewable energy technology"@en ;
    skos:definition "A technology that generates energy from a renewable source — solar, wind, small hydro, geothermal, or renewable biomass — without material depletion of the resource."@en .

cdm:SolarPV a skos:Concept ;
    skos:inScheme cdm:TechnologyTypeScheme ;
    skos:prefLabel "Solar photovoltaic system"@en ;
    skos:definition "A system that converts solar irradiance directly to electricity via the photovoltaic effect."@en ;
    skos:broader cdm:RenewableEnergyTechnology .

cdm:SolarThermal a skos:Concept ;
    skos:inScheme cdm:TechnologyTypeScheme ;
    skos:prefLabel "Solar thermal system"@en ;
    skos:definition "A system that uses solar energy to produce heat or to drive a thermodynamic cycle for electricity generation."@en ;
    skos:broader cdm:RenewableEnergyTechnology .

cdm:WindTurbine a skos:Concept ;
    skos:inScheme cdm:TechnologyTypeScheme ;
    skos:prefLabel "Wind turbine"@en ;
    skos:definition "A turbine that converts kinetic energy of wind to electricity."@en ;
    skos:broader cdm:RenewableEnergyTechnology .

cdm:SmallHydro a skos:Concept ;
    skos:inScheme cdm:TechnologyTypeScheme ;
    skos:prefLabel "Small hydropower system"@en ;
    skos:definition "A run-of-river or reservoir hydropower installation with capacity within the CDM small hydro threshold (typically ≤ 15 MW)."@en ;
    skos:broader cdm:RenewableEnergyTechnology .

cdm:GeothermalSystem a skos:Concept ;
    skos:inScheme cdm:TechnologyTypeScheme ;
    skos:prefLabel "Geothermal system"@en ;
    skos:definition "A system that extracts thermal energy from the Earth to generate electricity or provide heat."@en ;
    skos:broader cdm:RenewableEnergyTechnology .

cdm:RenewableBiomassSystem a skos:Concept ;
    skos:inScheme cdm:TechnologyTypeScheme ;
    skos:prefLabel "Renewable biomass energy system"@en ;
    skos:definition "A combustion or conversion system that uses renewable biomass as fuel, with no or negligible fossil co-firing."@en ;
    skos:broader cdm:RenewableEnergyTechnology .

cdm:NonRenewableEnergyTechnology a skos:Concept ;
    skos:inScheme cdm:TechnologyTypeScheme ;
    skos:topConceptOf cdm:TechnologyTypeScheme ;
    skos:prefLabel "Non-renewable energy technology"@en ;
    skos:definition "A technology that generates energy primarily from fossil fuels or other non-renewable sources."@en .

#################################################################
# EnergySourceScheme concepts
#################################################################

cdm:FossilFuel a skos:Concept ;
    skos:inScheme cdm:EnergySourceScheme ;
    skos:topConceptOf cdm:EnergySourceScheme ;
    skos:prefLabel "Fossil fuel"@en ;
    skos:definition "A carbon-based fuel derived from ancient organic material — coal, petroleum, or natural gas — whose combustion releases sequestered carbon."@en .

cdm:NaturalGas a skos:Concept ;
    skos:inScheme cdm:EnergySourceScheme ;
    skos:prefLabel "Natural gas"@en ;
    skos:broader cdm:FossilFuel .

cdm:Coal a skos:Concept ;
    skos:inScheme cdm:EnergySourceScheme ;
    skos:prefLabel "Coal"@en ;
    skos:broader cdm:FossilFuel .

cdm:Diesel a skos:Concept ;
    skos:inScheme cdm:EnergySourceScheme ;
    skos:prefLabel "Diesel"@en ;
    skos:broader cdm:FossilFuel .

cdm:HeavyFuelOil a skos:Concept ;
    skos:inScheme cdm:EnergySourceScheme ;
    skos:prefLabel "Heavy fuel oil"@en ;
    skos:broader cdm:FossilFuel .

cdm:LPG a skos:Concept ;
    skos:inScheme cdm:EnergySourceScheme ;
    skos:prefLabel "Liquefied petroleum gas"@en ;
    skos:altLabel "LPG"@en ;
    skos:broader cdm:FossilFuel .

cdm:BiomassSource a skos:Concept ;
    skos:inScheme cdm:EnergySourceScheme ;
    skos:topConceptOf cdm:EnergySourceScheme ;
    skos:prefLabel "Biomass source"@en ;
    skos:definition "A biological material used as fuel. Renewable biomass is considered carbon-neutral under CDM rules; non-renewable biomass is not."@en .

cdm:RenewableBiomass a skos:Concept ;
    skos:inScheme cdm:EnergySourceScheme ;
    skos:prefLabel "Renewable biomass"@en ;
    skos:broader cdm:BiomassSource .

cdm:NonRenewableBiomass a skos:Concept ;
    skos:inScheme cdm:EnergySourceScheme ;
    skos:prefLabel "Non-renewable biomass"@en ;
    skos:broader cdm:BiomassSource .

#################################################################
# GridConnectionScheme concepts
#################################################################

cdm:GridConnectedSystem a skos:Concept ;
    skos:inScheme cdm:GridConnectionScheme ;
    skos:topConceptOf cdm:GridConnectionScheme ;
    skos:prefLabel "Grid-connected system"@en ;
    skos:definition "A generation system electrically connected to a national or regional electricity grid and exporting electricity to that grid."@en .

cdm:OffGridSystem a skos:Concept ;
    skos:inScheme cdm:GridConnectionScheme ;
    skos:topConceptOf cdm:GridConnectionScheme ;
    skos:prefLabel "Off-grid system"@en ;
    skos:definition "A standalone generation system with no connection to a national or regional electricity grid."@en .

cdm:MiniGridSystem a skos:Concept ;
    skos:inScheme cdm:GridConnectionScheme ;
    skos:topConceptOf cdm:GridConnectionScheme ;
    skos:prefLabel "Mini-grid system"@en ;
    skos:definition "A local distribution network serving a defined community, not connected to the national grid."@en .

cdm:CaptiveUseSystem a skos:Concept ;
    skos:inScheme cdm:GridConnectionScheme ;
    skos:topConceptOf cdm:GridConnectionScheme ;
    skos:prefLabel "Captive use system"@en ;
    skos:definition "A generation system whose output is consumed entirely on-site by the owner, with no export to a third-party grid or network."@en .

#################################################################
# SectoralScopeScheme concepts
#################################################################

cdm:SectoralScope1 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Energy industries (renewable/non-renewable sources)"@en ;
    skos:notation "1" .

cdm:SectoralScope2 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Energy distribution"@en ;
    skos:notation "2" .

cdm:SectoralScope3 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Energy demand"@en ;
    skos:notation "3" .

cdm:SectoralScope4 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Manufacturing industries"@en ;
    skos:notation "4" .

cdm:SectoralScope5 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Chemical industry"@en ;
    skos:notation "5" .

cdm:SectoralScope6 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Construction"@en ;
    skos:notation "6" .

cdm:SectoralScope7 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Transport"@en ;
    skos:notation "7" .

cdm:SectoralScope8 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Mining/mineral production"@en ;
    skos:notation "8" .

cdm:SectoralScope9 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Metal production"@en ;
    skos:notation "9" .

cdm:SectoralScope10 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Fugitive emissions from fuels (solid, oil, and gas)"@en ;
    skos:notation "10" .

cdm:SectoralScope11 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Fugitive emissions from production and consumption of halocarbons and sulphur hexafluoride"@en ;
    skos:notation "11" .

cdm:SectoralScope12 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Solvents use"@en ;
    skos:notation "12" .

cdm:SectoralScope13 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Waste handling and disposal"@en ;
    skos:notation "13" .

cdm:SectoralScope14 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Afforestation and reforestation"@en ;
    skos:notation "14" .

cdm:SectoralScope15 a skos:Concept ;
    skos:inScheme cdm:SectoralScopeScheme ;
    skos:topConceptOf cdm:SectoralScopeScheme ;
    skos:prefLabel "Agriculture"@en ;
    skos:notation "15" .

#################################################################
# ScaleScheme concepts
#################################################################

cdm:LargeScale a skos:Concept ;
    skos:inScheme cdm:ScaleScheme ;
    skos:topConceptOf cdm:ScaleScheme ;
    skos:prefLabel "Large-scale CDM"@en ;
    skos:definition "CDM project activity governed by large-scale baseline and monitoring methodologies (ACM, AM, AMS category thresholds exceeded)."@en .

cdm:SmallScale a skos:Concept ;
    skos:inScheme cdm:ScaleScheme ;
    skos:topConceptOf cdm:ScaleScheme ;
    skos:prefLabel "Small-scale CDM"@en ;
    skos:definition "CDM project activity governed by AMS (approved small-scale) methodologies, meeting the capacity or emissions thresholds defined in the AMS appendix."@en .
