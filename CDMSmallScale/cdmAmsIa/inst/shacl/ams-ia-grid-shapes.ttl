@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-I.A — grid connection applicability shape only.
# AMS-I.A is user-sited: off-grid, captive use, or mini-grid only.
# Grid-connected export projects must use AMS-I.D or ACM0002.

cdm:AmsIaGridConnectionShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-I.A user-sited connection"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasGridConnectionType> ;
        sh:in (
            <http://independentimpact.org/cdm/OffGridSystem>
            <http://independentimpact.org/cdm/CaptiveUseSystem>
            <http://independentimpact.org/cdm/MiniGridSystem>
        ) ;
        sh:minCount 1 ;
        sh:message "AMS-I.A condition 2(b): project must be user-sited (off-grid, captive use, or mini-grid). Declare cdm:hasGridConnectionType with one of: cdm:OffGridSystem, cdm:CaptiveUseSystem, cdm:MiniGridSystem."@en
    ] .
