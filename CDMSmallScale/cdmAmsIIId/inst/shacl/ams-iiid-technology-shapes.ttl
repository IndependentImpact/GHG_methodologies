@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-III.D — technology type applicability shape.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:AmsIIIdTechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-III.D technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/ManureMethaneCapture> ;
        sh:minCount 1 ;
        sh:message "AMS-III.D condition (a): project must implement a manure methane capture system."@en
    ] .
