@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-III.D — waste type applicability shape.

cdm:AmsIiidWasteTypeShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-III.D waste type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasWasteType> ;
        sh:class <http://independentimpact.org/cdm/AnimalManure> ;
        sh:minCount 1 ;
        sh:message "AMS-III.D condition (b): waste stream must be animal manure."@en
    ] .
