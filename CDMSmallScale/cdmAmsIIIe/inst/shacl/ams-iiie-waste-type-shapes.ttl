@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-III.E — waste type applicability shape.

cdm:AmsIiieWasteTypeShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-III.E waste type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasWasteType> ;
        sh:class <http://independentimpact.org/cdm/OrganicWaste> ;
        sh:minCount 1 ;
        sh:message "AMS-III.E condition (b): feedstock must be organic waste that would otherwise decompose anaerobically."@en
    ] .
