@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-II.F — technology type applicability shape.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:AmsIIfTechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-II.F technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/EnergyEfficiencyTechnology> ;
        sh:minCount 1 ;
        sh:message "AMS-II.F condition (a): project must implement an energy efficiency technology."@en
    ] .
