@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-II.F — facility type applicability shape.

cdm:AmsIifFacilityShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-II.F facility type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasFacilityType> ;
        sh:class <http://independentimpact.org/cdm/AgriculturalFacility> ;
        sh:minCount 1 ;
        sh:message "AMS-II.F condition (b): project must be implemented at an agricultural facility."@en
    ] .
