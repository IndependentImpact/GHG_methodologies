@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-III.A — technology type applicability shape.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:AmsIIIaTechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-III.A technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/BiologicalNitrogenFixation> ;
        sh:minCount 1 ;
        sh:message "AMS-III.A condition (a): project must implement biological nitrogen fixation through inoculated leguminous crop cultivation."@en
    ] .
