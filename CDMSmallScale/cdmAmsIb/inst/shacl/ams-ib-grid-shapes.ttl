@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-I.B — grid connection applicability shape only.

cdm:AmsIbGridConnectionShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-I.B grid connection"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasGridConnectionType> ;
        sh:in (
            <http://independentimpact.org/cdm/OffGridSystem>
            <http://independentimpact.org/cdm/CaptiveUseSystem>
            <http://independentimpact.org/cdm/MiniGridSystem>
        ) ;
        sh:minCount 1 ;
        sh:message "AMS-I.B condition 2(b): project must be user-sited (off-grid, captive, or mini-grid)."@en
    ] .
