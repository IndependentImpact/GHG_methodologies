@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-III.F — waste type applicability shape.

cdm:AmsIiifWasteTypeShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-III.F waste type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasWasteType> ;
        sh:class <http://independentimpact.org/cdm/OrganicWaste> ;
        sh:minCount 1 ;
        sh:message "AMS-III.F condition (b): waste stream must be organic waste suitable for aerobic composting."@en
    ] .
