@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-II.Q — facility type applicability shape.

cdm:AmsIiqFacilityShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-II.Q facility type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasFacilityType> ;
        sh:class <http://independentimpact.org/cdm/CommercialBuilding> ;
        sh:minCount 1 ;
        sh:message "AMS-II.Q condition (b): project must be implemented in a commercial building."@en
    ] .
