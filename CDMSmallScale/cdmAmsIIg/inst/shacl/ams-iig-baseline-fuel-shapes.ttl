@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-II.G — baseline fuel type applicability shape.

cdm:AmsIigBaselineFuelShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-II.G baseline fuel type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasBaselineFuelType> ;
        sh:class <http://independentimpact.org/cdm/NonRenewableBiomass> ;
        sh:minCount 1 ;
        sh:message "AMS-II.G condition (b): baseline must use non-renewable biomass as the primary fuel."@en
    ] .
