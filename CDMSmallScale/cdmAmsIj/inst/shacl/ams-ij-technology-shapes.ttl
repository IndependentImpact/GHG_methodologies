@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-I.J — technology type applicability shape only.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:AmsIjTechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-I.J technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/SolarThermal> ;
        sh:minCount 1 ;
        sh:message "AMS-I.J condition 2(a): project must implement a solar thermal technology (solar water heating). Declare cdm:SolarThermal via aiao:isPerformedWith."@en
    ] .
