@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-III.H — waste type applicability shape.

cdm:AmsIiihWasteTypeShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-III.H waste type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasWasteType> ;
        sh:class <http://independentimpact.org/cdm/Wastewater> ;
        sh:minCount 1 ;
        sh:message "AMS-III.H condition (b): waste stream must be wastewater with sufficient organic load for anaerobic treatment."@en
    ] .
