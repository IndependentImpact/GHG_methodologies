@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-II.H — facility type applicability shape.

cdm:AmsIihFacilityShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-II.H facility type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasFacilityType> ;
        sh:class <http://independentimpact.org/cdm/CentralizedUtilityFacility> ;
        sh:minCount 1 ;
        sh:message "AMS-II.H condition (b): project must be implemented at a centralized utility facility."@en
    ] .
