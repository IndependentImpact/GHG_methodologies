@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-III.G — waste type applicability shape.

cdm:AmsIiigWasteTypeShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-III.G waste type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasWasteType> ;
        sh:class <http://independentimpact.org/cdm/MunicipalSolidWaste> ;
        sh:minCount 1 ;
        sh:message "AMS-III.G condition (b): waste stream must be municipal solid waste in a landfill."@en
    ] .
