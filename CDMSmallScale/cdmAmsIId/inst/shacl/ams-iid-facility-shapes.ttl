@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-II.D — facility type applicability shape.

cdm:AmsIidFacilityShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-II.D facility type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasFacilityType> ;
        sh:class <http://independentimpact.org/cdm/IndustrialFacility> ;
        sh:minCount 1 ;
        sh:message "AMS-II.D condition (b): project must be implemented at an industrial facility."@en
    ] .
