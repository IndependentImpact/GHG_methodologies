@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-I.E — technology type applicability shape only.
# Run materialise_skos_hierarchy() before validate_shacl().

cdm:AmsIeTechnologyShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-I.E technology type"@en ;
    sh:property [
        sh:path <http://w3id.org/aiao#isPerformedWith> ;
        sh:class <http://independentimpact.org/cdm/RenewableEnergyTechnology> ;
        sh:minCount 1 ;
        sh:message "AMS-I.E condition 2(a): project must switch to a renewable energy source (e.g. renewable biomass or solar thermal)."@en
    ] .
