@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-III.AJ — waste type applicability shape.

cdm:AmsIiiajWasteTypeShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-III.AJ waste type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasWasteType> ;
        sh:class <http://independentimpact.org/cdm/RecyclableMaterial> ;
        sh:minCount 1 ;
        sh:message "AMS-III.AJ condition (b): waste stream must be recyclable material (paper, plastics, metals, or glass)."@en
    ] .
