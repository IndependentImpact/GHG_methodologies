@prefix cdm:  <http://independentimpact.org/cdm/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# AMS-II.E — facility type applicability shape.

cdm:AmsIieFacilityShape a sh:NodeShape ;
    sh:targetClass <http://independentimpact.org/cdm/CDMProjectActivity> ;
    sh:name "AMS-II.E facility type"@en ;
    sh:property [
        sh:path <http://independentimpact.org/cdm/hasFacilityType> ;
        sh:class <http://independentimpact.org/cdm/Building> ;
        sh:minCount 1 ;
        sh:message "AMS-II.E condition (b): project must be implemented in a building (residential, commercial, or public)."@en
    ] .
